{
  "name": "needledrop",
  "version": "1.1.0",
  "description": "A spinning-vinyl companion window with animated, word-by-word synced lyrics for Apple Music and Spotify on Windows 11",
  "main": "main.js",
  "keywords": ["apple-music", "spotify", "lyrics", "vinyl", "windows", "electron", "karaoke"],
  "author": "Nadav",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "electron .",
    "start:spotify": "electron . --edition=spotify",
    "demo": "electron . --demo",
    "demo:spotify": "electron . --demo --edition=spotify",
    "test": "node --test test/lyrics.test.js test/editions.test.js",
    "icon": "electron tools/make-icon.js",
    "dist:apple": "npm test && node tools/build.js apple",
    "dist:spotify": "npm test && node tools/build.js spotify",
    "dist": "npm test && node tools/build.js apple spotify"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
